# ============================================================
# FLOODSAFE — Environment Variables Example
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Frontend (Vite) — VITE_ prefix exposes vars to the browser ──────
# SOS API base URL (leave as /api when using Vite proxy in dev)
VITE_SOS_API_URL=/api

# Show test SOS button (set "true" only during development/testing)
VITE_SHOW_TEST_SOS=false

# ── Backend — NOT exposed to the browser ────────────────────────────

# TextBee SMS Gateway (https://textbee.dev)
TEXTBEE_API_KEY=[YOUR_TEXTBEE_API_KEY]
TEXTBEE_DEVICE_ID=[YOUR_TEXTBEE_DEVICE_ID]

# Emergency contacts in E.164 format (e.g. +919876543210)
# Add as many as needed: EMERGENCY_CONTACT_1, _2, _3, ...
EMERGENCY_CONTACT_1=[FILL_THIS]
EMERGENCY_CONTACT_2=[FILL_THIS]
EMERGENCY_CONTACT_3=[FILL_THIS]

# Test mode — sends only to TEST_RECIPIENT_PHONE when ENABLE_TEST_MODE=true
TEST_RECIPIENT_PHONE=[FILL_THIS]
ENABLE_TEST_MODE=false

# Backend server port
PORT=3001

# Name shown in SMS messages
USER_NAME=[YOUR_NAME]

# ── FFGS -> SOS interface (authority alerts) ────────────────────────
# Shared secret the ml-pipeline (src/alerts/authority_sos.py) must send as
# the X-Internal-Api-Key header on POST /api/sos/authority-alert. Generate
# any long random string; leaving this unset disables the endpoint entirely.
INTERNAL_API_KEY=[GENERATE_A_RANDOM_SECRET]

# District-level authority contacts, one var per pilot district, comma-
# separated E.164 numbers. Fill these in with real disaster-management-
# authority numbers before relying on this for real alerts -- until then,
# alerts still get recorded in the FFGS `alerts` table, they just have no
# SMS recipient.
AUTHORITY_CONTACT_CHAMOLI=[FILL_THIS]
AUTHORITY_CONTACT_BAGESHWAR=[FILL_THIS]
AUTHORITY_CONTACT_RUDRAPRAYAG=[FILL_THIS]
AUTHORITY_CONTACT_PITHORAGARH=[FILL_THIS]
AUTHORITY_CONTACT_UTTARKASHI=[FILL_THIS]

# PostgreSQL / PostGIS connection for flash_flood_db
FFS_DB_HOST=localhost
FFS_DB_PORT=5432
FFS_DB_NAME=flash_flood_db
FFS_DB_USER=postgres
FFS_DB_PASSWORD=changeme

# MQTT broker (Phase 2 — IoT)
FFS_MQTT_HOST=localhost
FFS_MQTT_PORT=1883

# Redis (Phase 2 — background processing)
FFS_REDIS_URL=redis://localhost:6379/0

# FFGS -> SOS interface (src/alerts/authority_sos.py). Must match the
# FLOODSAFE backend's INTERNAL_API_KEY (see ../.env.example) exactly.
AUTHORITY_ALERT_API_URL=http://localhost:3001/api/sos/authority-alert
AUTHORITY_ALERT_API_KEY=[SAME_VALUE_AS_BACKEND_INTERNAL_API_KEY]
